{UTF-8}
Incremento=
	TasaP-tasaV
	~	
	~		|

inventarioP=
	Almacen+proveedor
	~	
	~		|

"Errror/Faltante"=
	Objetivo-Almacen
	~	
	~		|

Almacen= INTEG (
	proveedor-Ventas,
		300
		)
	~	Año
	~		|

controlAV=
	INTEGER(Almacen-Ventas)
	~	Año
	~		|

ventastotal= INTEG (
	Ventas,
		Ventas)
	~	Año
	~		|

Ventas=
	Almacen*tasaV
	~	
	~		|

Discrepancia=
	INTEGER(Objetivo-Almacen)
	~	Año
	~		|

Objetivo=
	600
	~	Año
	~		|

proveedor=
	Discrepancia*TasaP
	~	Año
	~		|

TasaP=
	0.2
	~	
	~		|

tasaV=
	0.01
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Parámetros de control de simulación
	|

FINAL TIME  = 2040
	~	Año
	~	El período final de la simulación.
	|

INITIAL TIME  = 2023
	~	Año
	~	El período inicial de la simulación.
	|

SAVEPER  = 
        TIME STEP
	~	Año [0,?]
	~	La frecuencia con la que se almacena la salida.
	|

TIME STEP  = 1
	~	Año [0,?]
	~	The time step for the simulation.
	|

