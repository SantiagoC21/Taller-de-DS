{UTF-8}
Cantidad de accidentes=INTEGER (((Porcentaje de congestion vehicular * 0.05 + (1 - Tasa de fluidez del trafico\
		) * 0.02) * Discrepacia) )
	~	
	~		|

Objetivo=600
	~	
	~		|

Discrepacia=ABS ( INTEGER (Objetivo - Accidentes de tránsito) )
	~	
	~		|

"Error / Faltante"=ABS ( Objetivo - Accidentes de tránsito )
	~	
	~		|

Accidentes de tránsito= INTEG (INTEGER (Cantidad de accidentes-Accidentes prevenidos\
		) ,
		1000)
	~	
	~		|

Calidad de infraestructura vial= INTEG (
	Mejora de infraestructura-Deterioro de infraestructura,
		50)
	~	
	~		|

Confianza pública= INTEG (
	Recuperacion de confianza-Perdida de confianza,
		0.5
		)
	~	
	~		|

Porcentaje de congestion vehicular=1 - Calidad de infraestructura vial * 0.01
	~	
	~		|

Depreciacion de inversion=
	Inversion en infraestructura*5e-06
	~	
	~		|

Deterioro de imagen=
	Quejas de usuarios * 0.05
	~	
	~		|

Deterioro de infraestructura=
	Calidad de infraestructura vial * 0.03
	~	
	~		|

Accidentes prevenidos=INTEGER ( Accidentes de tránsito * Total regulaciones viales *\
		 0.01 )
	~	
	~		|

Tasa de fluidez del trafico=1 / (1 + Porcentaje de congestion vehicular)
	~	
	~		|

Flujo de inversion=
	Tasa de recaudacion * Porcentaje de inversion
	~	
	~		|

Imagen pública de autoridades= INTEG (
	Mejora de imagen-Deterioro de imagen,
		0.5)
	~	
	~		|

Infracciones vehiculares=
	max(0, 1 - Total regulaciones viales * 0.05)
	~	
	~		|

Inversion en infraestructura= INTEG (
	Flujo de inversion-Depreciacion de inversion,
		10000)
	~	
	~		|

Mejora de imagen=
	(Satisfaccion de usuarios + Satisfaccion de autoridades de transporte) / 2 * 0.03
	~	
	~		|

Mejora de infraestructura=
	Flujo de inversion * 0.7
	~	
	~		|

Pagos de tributos de transporte=
	Infracciones vehiculares * 0.5
	~	
	~		|

Perdida de confianza=
	Accidentes de tránsito * 5e-05
	~	
	~		|

Porcentaje de inversion=
	0.3
	~	
	~		|

Quejas de usuarios=
	Tasa de quejas de usuarios * 100
	~	
	~		|

Recuperacion de confianza=
	(Satisfaccion de usuarios + Satisfaccion de autoridades de transporte) / 2 * 0.04
	~	
	~		|

Satisfaccion de autoridades de transporte=
	Tasa de viajes de transporte * 0.05
	~	
	~		|

Satisfaccion de usuarios=
	Calidad de infraestructura vial * 0.05 - Porcentaje de congestion vehicular * 0.03
	~	
	~		|

Tasa de quejas de usuarios=
	max(0, 1 - Satisfaccion de usuarios)
	~	
	~		|

Tasa de recaudacion=
	25
	~	
	~		|

Tasa de viajes de transporte=
	Tasa de fluidez del trafico * 0.1 + Pagos de tributos de transporte * 0.1
	~	
	~		|

Total regulaciones viales=1 + Calidad de infraestructura vial * 0.05
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2028
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 2015
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

