Cantidad de paradas del vehiculo  = A FUNCTION OF( Pasajeros por dìa)
	~	
	~		|

Cantidad de vehiculos en operacion  = A FUNCTION OF( Frecuencia de uso de vehiculos,Inactividad de Vehiculos\
		)
	~	
	~		|

Capacitacion del personal de mantenimiento  = A FUNCTION OF( Politicas de seguridad vial\
		)
	~	
	~		|

Componentes Desgastados  = A FUNCTION OF( Cantidad de paradas del vehiculo,Km recorridos por vehiculos\
		,Velocidad promedio de vehiculos)
	~	
	~		|

Contaminación de la ruta  = A FUNCTION OF( Frecuencia de Fallas Mecánicas)
	~	
	~		|

Cumplimiento del servicio  = A FUNCTION OF( Disponibilidad de la flota)
	~	
	~		|

Disponibilidad de la flota  = A FUNCTION OF( Cantidad de vehiculos en operacion)
	~	
	~		|

Disponibilidad de Repuestos  = A FUNCTION OF( Frecuencia de Mantenimiento Preventivo)
	~	
	~		|

Disponibilidad de Talleres  = A FUNCTION OF( Disponibilidad de Repuestos,Numero de Tecnicos Disponibles\
		)
	~	
	~		|

Frecuencia de Fallas Mecánicas  = A FUNCTION OF( Frecuencia de Mantenimiento Preventivo\
		)
	~	
	~		|

Frecuencia de Interrupciones del servicio  = A FUNCTION OF( Inactividad de Vehiculos,\
		Malas condiciones de via)
	~	
	~		|

Frecuencia de Mantenimiento  = A FUNCTION OF( Disponibilidad de Talleres,Frecuencia de Fallas Mecánicas\
		)
	~	
	~		|

Frecuencia de Mantenimiento Preventivo  = A FUNCTION OF( Disponibilidad de Talleres,Frecuencia de Mantenimiento\
		,Presupuesto asignado a mantenimiento)
	~	
	~		|

Frecuencia de uso de vehiculos  = A FUNCTION OF( Vida Util de los Componentes)
	~	
	~		|

Inactividad de Vehiculos  = A FUNCTION OF( Frecuencia de Fallas Mecánicas,Tiempo de Reparacion\
		)
	~	
	~		|

Km recorridos por vehiculos  = A FUNCTION OF( Velocidad promedio de vehiculos)
	~	
	~		|

Malas condiciones de via  = A FUNCTION OF( Contaminación de la ruta)
	~	
	~		|

Numero de Tecnicos Disponibles  = A FUNCTION OF( Capacitacion del personal de mantenimiento\
		)
	~	
	~		|

Pasajeros por dìa  = A FUNCTION OF( Componentes Desgastados,Satisfaccion del Usuario\
		)
	~	
	~		|

Politicas de seguridad vial  = A FUNCTION OF( )
	~	
	~		|

Presupuesto asignado a mantenimiento  = A FUNCTION OF( Politicas de seguridad vial)
	~	
	~		|

Satisfaccion del Usuario  = A FUNCTION OF( Cumplimiento del servicio,Frecuencia de Interrupciones del servicio\
		,Malas condiciones de via)
	~	
	~		|

Tiempo de Reparacion  = A FUNCTION OF( Capacitacion del personal de mantenimiento,Disponibilidad de Repuestos\
		,Numero de Tecnicos Disponibles)
	~	
	~		|

Velocidad promedio de vehiculos  = A FUNCTION OF( Politicas de seguridad vial)
	~	
	~		|

Vida Util de los Componentes  = A FUNCTION OF( Componentes Desgastados)
	~	
	~		|

