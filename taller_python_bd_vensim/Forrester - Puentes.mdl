{UTF-8}
Costo Unitario de Mantenimiento=
	10000
	~	
	~		|

Factor de Uso=
	0.8
	~	
	~		|

Gastos Totales=
	Puentes en Construccion*1200+Mantenimiento*Costo Unitario de Mantenimiento
	~	
	~		|

Mantenimiento=
	Puentes Construidos*12*Tasa de calidad de matenimiento*Factor de Uso
	~	
	~		|

Tasa de calidad de matenimiento=
	0.5
	~	
	~		|

Puentes en Construccion=
	INTEGER(Puentes Construidos*Tasa Puentes Construccion/(Tasa de terminacion))
	~	
	~		|

Puentes Obsoletos=
	INTEGER(Puentes Construidos*Tasa Puentes Obsoletos/Tasa de demolicion)
	~	
	~		|

Tasa de demolicion=
	10*Tasa Puentes Obsoletos
	~	
	~		|

Tasa de terminacion=
	0.6
	~	
	~		|

Puentes Construidos= INTEG (
	Puentes en Construccion-Puentes Obsoletos,
		80)
	~	
	~		|

Tasa Puentes Construccion=
	0.04
	~	
	~		|

Tasa Puentes Obsoletos=
	0.009
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2032
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 2022
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

