{UTF-8}
Fondos asignados para mantenimiento=Fondos para mantenimiento*Tasa de mantenimiento
	~	
	~		|

Fondos para mantenimiento= INTEG (Fondos asignados para mantenimiento-Gastos en mantenimiento\
		,
		10000)
	~	
	~		|

Pistas en mantenimiento= INTEG (Pistas retiradas para mantenimiento-Pistas reparadas,
		100)
	~	
	~		|

Monto Total Pistas=Pistas en construccion*1200+Gastos en mantenimiento
	~	
	~		|

Costo promedio por mantenimiento=30
	~	
	~		|

Pistas retiradas para mantenimiento=Pistas en mantenimiento*Tasa de retiro de pistas para mantenimiento
	~	
	~		|

Tasa de mantenimiento=0.01
	~	
	~		|

Gastos en mantenimiento=Costo promedio por mantenimiento*Pistas en mantenimiento
	~	
	~		|

Tasa de retiro de pistas para mantenimiento=0.003
	~	
	~		|

Pistas reparadas=Pistas en mantenimiento*Tasa de reparación de pistas
	~	
	~		|

Tasa de reparación de pistas=0.002
	~	
	~		|

Cantidad de litros de pintura=
	INTEGER(Pistas asfaltadas*0.6)
	~	
	~		|

Cantidad de mano de obra persona=
	INTEGER(Pistas asfaltadas*0.3)
	~	
	~		|

Cantidad de maquinarias total=
	INTEGER(Pistas asfaltadas*0.5)
	~	
	~		|

Cantidad maquinas asfaltos=
	INTEGER(Pistas asfaltadas*0.4)
	~	
	~		|

Pistas asfaltadas=
	INTEGER(Pistas Construidas*0.8)
	~	
	~		|

Pistas Construidas= INTEG (
	Pistas en construccion-Pistas obsoletas,
		130)
	~	
	~		|

Pistas en construccion=
	INTEGER(Pistas Construidas*Tasa Pistas Construccion)
	~	
	~		|

Pistas obsoletas=
	INTEGER(Pistas Construidas*Tasa Pistas Obsoletas)
	~	
	~		|

Tasa Pistas Construccion=
	0.03
	~	
	~		|

Tasa Pistas Obsoletas=
	0.009
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Parámetros de control de simulación
	|

FINAL TIME  = 2032
	~	Año
	~	El período final de la simulación.
	|

INITIAL TIME  = 2022
	~	Año
	~	El período inicial de la simulación.
	|

SAVEPER  = 
        TIME STEP
	~	Año [0,?]
	~	La frecuencia con la que se almacena la salida.
	|

TIME STEP  = 1
	~	Año [0,?]
	~	The time step for the simulation.
	|

