{UTF-8}
Demanda de veredas=
	Uso de veredas*Veredas obsoletas
	~	
	~		|

Factor de desgaste natural=
	0.06
	~	
	~		|

Tasa Veredas Construccion=
	0.03*Demanda de veredas
	~	
	~		|

Mantenimiento Veredas=
	Veredas Construidas*12/Factor de desgaste natural
	~	
	~		|

Uso de veredas=
	0.95
	~	
	~		|

Tasa Veredas Obsoletas=
	0.45*Uso de veredas*Factor de desgaste natural
	~	
	~		|

Gastos Totales Veredas=
	Veredas en construccion*1200+Mantenimiento Veredas
	~	
	~		|

Veredas Construidas= INTEG (
	Veredas en construccion-Veredas obsoletas,
		100)
	~	
	~		|

Veredas en construccion=
	INTEGER(Veredas Construidas*Tasa Veredas Construccion)
	~	
	~		|

Veredas obsoletas=
	INTEGER( Veredas Construidas*Tasa Veredas Obsoletas )
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Parámetros de control de simulación
	|

FINAL TIME  = 2032
	~	Año
	~	El período final de la simulación.
	|

INITIAL TIME  = 2022
	~	Año
	~	El período inicial de la simulación.
	|

SAVEPER  = 
        TIME STEP
	~	Año [0,?]
	~	La frecuencia con la que se almacena la salida.
	|

TIME STEP  = 1
	~	Año [0,?]
	~	The time step for the simulation.
	|

