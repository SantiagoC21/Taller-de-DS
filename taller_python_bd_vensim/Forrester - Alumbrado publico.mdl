{UTF-8}
Alumbrado en mantenimiento= INTEG (Unidades retiradas para mantenimiento-Unidades reparadas\
		,
		50
		)
	~	
	~		|

Alumbrado Publico Construidos= INTEG (Alumbrado publico en construccion-Alumbrado publico obsoletas\
		,
		85)
	~	
	~		|

Puntos retirados por falla=Puntos luminarios operativos*Tasa de retiro de puntos por falla
	~	
	~		|

Tasa de retiro de puntos por falla=0.005
	~	
	~		|

Costo promedio mantenimiento=20
	~	
	~		|

Fondos asignados para mantenimiento=Presupuesto mantenimiento*Tasa de mantenimiento
	~	
	~		|

Gastos en mantenimiento=Alumbrado en mantenimiento*Costo promedio mantenimiento
	~	
	~		|

Gastos Totales Alumbrado Publico=Alumbrado publico en construccion*800+
	+Pago por tecnicos contratados+Maquinaria comprada+Gastos en mantenimiento+Puntos luminarios operativos\
		*500*Tasa de instalación de nuevos puntos
	~	
	~		|

Tasa de reparación de unidades=0.002
	~	
	~		|

Tasa de retiro de unidades de alumbrado=0.003
	~	
	~		|

Presupuesto mantenimiento= INTEG (Fondos asignados para mantenimiento-Gastos en mantenimiento\
		,
		100000)
	~	
	~		|

Puntos instalados nuevos=Puntos luminarios operativos*Tasa de instalación de nuevos puntos
	~	
	~		|

Puntos luminarios operativos= INTEG (Puntos instalados nuevos-Puntos retirados por falla\
		,
		85)
	~	
	~		|

Tasa de mantenimiento=0.004
	~	
	~		|

Tasa de instalación de nuevos puntos=0.01
	~	
	~		|

Unidades reparadas=Alumbrado en mantenimiento*Tasa de reparación de unidades
	~	
	~		|

Unidades retiradas para mantenimiento=Alumbrado en mantenimiento*Tasa de retiro de unidades de alumbrado
	~	
	~		|

Alumbrado publico en construccion=
	INTEGER(Alumbrado Publico Construidos*Tasa Alumbrado Publico Construccion)
	~	
	~		|

Alumbrado publico obsoletas=
	INTEGER(Alumbrado Publico Construidos*Tasa Alumbrado Publico Obsoletas)
	~	
	~		|

Maquinaria comprada=
	INTEGER(Alumbrado Publico Construidos*2)
	~	
	~		|

Pago por tecnicos contratados=
	Alumbrado Publico Construidos*1.5
	~	
	~		|

Tasa Alumbrado Publico Construccion=
	0.05
	~	
	~		|

Tasa Alumbrado Publico Obsoletas=
	0.007
	~	
	~		|

